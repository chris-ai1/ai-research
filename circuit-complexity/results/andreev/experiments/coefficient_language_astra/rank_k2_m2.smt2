(set-logic QF_LRA)
(declare-fun z0 () Bool)
(declare-fun z1 () Bool)
(declare-fun z2 () Bool)
(declare-fun z3 () Bool)
(declare-fun z4 () Bool)
(declare-fun z5 () Bool)
(declare-fun z6 () Bool)
(declare-fun z7 () Bool)
(define-fun g0 () Bool (>= (+ (ite z0 1 0) (ite z4 1 0) (ite z5 (- 1) 0) (ite z6 2 0) (ite z7 (- 2) 0)) 1))
(define-fun g1 () Bool (>= (+ (ite z1 1 0) (ite z4 1 0) (ite z5 1 0) (ite z6 2 0) (ite z7 (- 2) 0)) 2))
(define-fun g2 () Bool (>= (+ (ite z2 1 0) (ite z4 1 0) (ite z5 (- 1) 0) (ite z6 2 0) (ite z7 2 0)) 3))
(define-fun g3 () Bool (>= (+ (ite z3 1 0) (ite z4 1 0) (ite z5 1 0) (ite z6 2 0) (ite z7 2 0)) 4))
(define-fun out () Bool (>= (+ (+ (ite g0 1 0) (ite g1 1 0) (ite g2 1 0) (ite g3 1 0)) (+ (ite z4 (- 1) 0) (ite z6 (- 2) 0))) 1))
(define-fun b0 () Bool (xor z4 z5))
(define-fun b1 () Bool (xor z6 z7))
(assert (xor out (ite b1 (ite b0 z3 z2) (ite b0 z1 z0))))
(check-sat)
