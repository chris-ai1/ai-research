+-- A depth-two circuit with at most `10` gates agrees with the function on at most `52%` of the
+-- inputs.
+example {r : BitString (16 * 20) → BitString (2 ^ 20)}
+    (hr : IsSmallBias ((1 / 2) ^ (7 * 20)) ((PMF.uniformOfFintype (BitString (16 * 20))).map r))
