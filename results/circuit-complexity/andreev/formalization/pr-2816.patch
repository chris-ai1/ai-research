+  have hcomb : 2 ^ k * (1 - (t + 1) * δ) ≤ 2 ^ k * (t * γ) := by
+    nlinarith [mul_le_mul_of_nonneg_left hbal ht0]
+  have := le_of_mul_le_mul_left hcomb h2k
+  linarith
